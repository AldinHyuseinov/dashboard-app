// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  tasks         Task[]
  comments      Comment[]
  reactions     Reaction[]
  uploadedFiles TaskFile[]
  activities    Activity[]
  taskOpenings  TaskOpening[]
  pushDevices   PushDevice[]

  /// When the user last opened the Activity Feed: what others did up to then
  /// is no longer Unread for them. Null until they first open it.
  lastFeedVisitAt DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDevices PushDevice[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TaskFile {
  id     String  @id @default(cuid())
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Who uploaded the file. Only they may attach it to a Task. Null only for
  // unattached files uploaded before uploaders were recorded.
  uploaderId String?
  uploader   User?   @relation(fields: [uploaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  fileName String
  fileType String
  data     Bytes

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model Comment {
  id     String @id @default(cuid())
  text   String @db.NVarChar(Max)
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  editedAt  DateTime?
  isPinned  Boolean   @default(false)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  /// The Comment a Reply answers: its top-level Comment or another Reply in the
  /// same thread. Null on top-level Comments.
  answersId  String?
  answers    Comment?  @relation("CommentAnswers", fields: [answersId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answeredBy Comment[] @relation("CommentAnswers")

  reactions  Reaction[]
  activities Activity[]
}

/// A lasting record that something happened to a Task: it was created,
/// edited, deleted or marked Done or not Done, or a Comment or Reply was
/// posted on it. The Activity Feed lists them newest first.
model Activity {
  id      String @id @default(cuid())
  /// One of the ActivityType values in lib/activity.ts.
  type    String
  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Deliberately not a relation: an Activity outlives the Task it concerns.
  taskId       String
  /// The Task's title and Category when this was recorded, so Activities of
  /// a deleted Task stay readable.
  taskTitle    String
  taskCategory String

  /// The Comment or Reply posted, for those Activity types. The Activity is
  /// deleted together with it.
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  occurredAt DateTime

  @@index([occurredAt, id])
  @@index([taskId])
  @@index([commentId])
}

/// When a user last opened a Task: its Activities up to then are no longer
/// Unread for them.
model TaskOpening {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Deliberately not a relation: like its Activities, it outlives the Task,
  /// so they stay read once the Task is deleted.
  taskId   String
  openedAt DateTime

  @@id([userId, taskId])
}

/// A browser where a user turned notifications on. Their Notifications go to
/// each of their push devices by push, and by email only when they have none.
/// A device belongs to the session it was turned on in: signing out of that
/// session removes it.
model PushDevice {
  id        String  @id @default(cuid())
  /// NoAction: the user's sessions already cascade here, and SQL Server allows
  /// only one cascade path.
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// The push service URL that reaches this browser. Push services keep it
  /// well under 800 characters, which keeps it indexable.
  endpoint String @unique @db.NVarChar(800)
  /// The browser's keys that each push is encrypted with.
  p256dh   String
  auth     String

  createdAt DateTime

  @@index([userId])
  @@index([sessionId])
}

model Reaction {
  id        String  @id @default(cuid())
  emoji     String
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([commentId, userId, emoji])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @db.NVarChar(Max)
  category    String
  isDone      Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files    TaskFile[]
  comments Comment[]
}
